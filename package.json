{
  "name": "meteor-dockerfile",
  "version": "1.1.0",
  "description": "Compile multistage Meteor Dockerfile",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && ncc build --source-map",
    "lint": "biome check src",
    "format": "biome check --write src"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "typescript": "6.0.3"
  }
}
